FLOWAGENT_ENV=development
FLOWAGENT_LOG_LEVEL=INFO
FLOWAGENT_ADMIN_API_TOKEN=replace-with-a-long-random-token
FLOWAGENT_CONFIG_ENCRYPTION_KEY=replace-with-a-random-32-byte-base64-key
FLOWAGENT_CORS_ORIGINS=["http://localhost:5173"]
FLOWAGENT_DATABASE_URL=sqlite+aiosqlite:///./flowagent.db
FLOWAGENT_AUTO_CREATE_TABLES=true
FLOWAGENT_LLM_BASE_URL=https://api.deepseek.com
FLOWAGENT_LLM_API_KEY=
FLOWAGENT_LLM_MODEL=deepseek-v4-flash
FLOWAGENT_LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
FLOWAGENT_MAX_AGENT_STEPS=5
FLOWAGENT_CONTEXT_TURNS=10
FLOWAGENT_TOOL_TIMEOUT_SECONDS=15
FLOWAGENT_GITHUB_BASE_URL=https://api.github.com
FLOWAGENT_GITHUB_API_VERSION=2026-03-10
FLOWAGENT_GITHUB_TOKEN=
FLOWAGENT_GITHUB_OWNER=
FLOWAGENT_GITHUB_REPO=
FLOWAGENT_GITHUB_DEFAULT_LABELS=["bug"]
FLOWAGENT_GITHUB_DEFAULT_ASSIGNEE=
FLOWAGENT_MEMBER_CAN_CREATE_ISSUE=false
FLOWAGENT_EMBEDDING_BASE_URL=https://api.openai.com/v1
FLOWAGENT_EMBEDDING_API_KEY=
FLOWAGENT_EMBEDDING_MODEL=text-embedding-3-small
FLOWAGENT_EMBEDDING_DIMENSIONS=1536
FLOWAGENT_KNOWLEDGE_CHUNK_SIZE=1000
FLOWAGENT_KNOWLEDGE_CHUNK_OVERLAP=150
FLOWAGENT_KNOWLEDGE_TOP_K=5
FLOWAGENT_KNOWLEDGE_MIN_SCORE=0.05
FLOWAGENT_KNOWLEDGE_MAX_FILE_BYTES=10485760
FLOWAGENT_ATTACHMENT_MAX_FILE_BYTES=10485760
# local 使用服务器本地 Whisper（推荐，语音不外传）；remote 使用兼容接口。
FLOWAGENT_TRANSCRIPTION_BACKEND=local
FLOWAGENT_TRANSCRIPTION_BASE_URL=
FLOWAGENT_TRANSCRIPTION_API_KEY=
FLOWAGENT_TRANSCRIPTION_MODEL=base
FLOWAGENT_TRANSCRIPTION_DEVICE=cpu
FLOWAGENT_TRANSCRIPTION_COMPUTE_TYPE=int8
FLOWAGENT_FEISHU_APP_ID=
FLOWAGENT_FEISHU_APP_SECRET=
FLOWAGENT_FEISHU_VERIFICATION_TOKEN=
FLOWAGENT_FEISHU_ENCRYPT_KEY=
FLOWAGENT_FEISHU_BOT_OPEN_ID=
FLOWAGENT_FEISHU_INTERNAL_CALLBACK_URL=http://127.0.0.1:8001/api/v1/channels/feishu/events
